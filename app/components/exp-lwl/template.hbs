<div class="exp-lwl__screen">
    <div id="recorder"></div>

    {{#if paused}}
        <div class="exp-lwl__message">
            <h2>Paused</h2>

            <p>
                Press {{pauseKeyDescription}} or select Continue when you are
                ready.
            </p>

            <button
                type="button"
                class="btn btn-primary"
                {{action "togglePause"}}
            >
                Continue
            </button>
        </div>
    {{else}}
        {{#if (eq phase "calibration")}}
            <div class="exp-lwl__stimuli">
                <div class="exp-lwl__image-cell">
                    {{#if calibrationOnLeft}}
                        <img
                            class="exp-lwl__image exp-lwl__calibration-image"
                            src={{fixationImageUrl}}
                            alt=""
                        >
                    {{/if}}
                </div>

                <div class="exp-lwl__image-cell">
                    {{#if calibrationOnRight}}
                        <img
                            class="exp-lwl__image exp-lwl__calibration-image"
                            src={{fixationImageUrl}}
                            alt=""
                        >
                    {{/if}}
                </div>
            </div>

{{else if (eq phase "light")}}
    <div class="exp-lwl__message">
        <img
            class="exp-lwl__startup-image"
            src={{lightImageUrl}}
            alt=""
        >
    </div>

{{else if (eq phase "dark")}}
    <div class="exp-lwl__message">
        <img
            class="exp-lwl__startup-image"
            src={{darkImageUrl}}
            alt=""
        >
    </div>

        {{else if (eq phase "intro")}}
            <div class="exp-lwl__message">
                <img
                    class="exp-lwl__fixation-image"
                    src={{fixationImageUrl}}
                    alt=""
                >
            </div>

        {{else if (eq phase "stimulus")}}
            <div class="exp-lwl__stimuli">
                <div class="exp-lwl__image-cell">
                    <img
                        class="exp-lwl__image"
                        src={{leftImageUrl}}
                        alt=""
                    >
                </div>

                <div class="exp-lwl__image-cell">
                    <img
                        class="exp-lwl__image"
                        src={{rightImageUrl}}
                        alt=""
                    >
                </div>
            </div>

        {{else if (eq phase "intertrial")}}
            <div class="exp-lwl__message">
                <img
                    class="exp-lwl__fixation-image"
                    src={{fixationImageUrl}}
                    alt=""
                >
            </div>

        {{else if (eq phase "attention")}}
            <div class="exp-lwl__attention">
                <video
                    class="exp-lwl__attention-video"
                    src={{attentionVideoUrl}}
                    preload="auto"
                    autoplay
                    playsinline
                    onended={{action "attentionEnded"}}
                    onerror={{action "attentionEnded"}}
                ></video>
            </div>

        {{else}}
            <div class="exp-lwl__message">
                <p>Please wait…</p>
            </div>
        {{/if}}
    {{/if}}
</div>