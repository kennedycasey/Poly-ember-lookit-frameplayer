<div id="recorder"></div>

{{#if (eq phase "calibration")}}

    <div class="exp-lwl__stimulus-container">
        <div class="exp-lwl__stimulus-side">
            {{#if calibrationOnLeft}}
                <img
                    class="exp-lwl__image"
                    src={{fixationImageUrl}}
                    alt=""
                >
            {{/if}}
        </div>

        <div class="exp-lwl__stimulus-side">
            {{#if calibrationOnRight}}
                <img
                    class="exp-lwl__image"
                    src={{fixationImageUrl}}
                    alt=""
                >
            {{/if}}
        </div>
    </div>

{{else}}

    {{#if (eq phase "light")}}

        <div class="exp-lwl__full-screen-image">
            <img
                class="exp-lwl__startup-image"
                src={{lightImageUrl}}
                alt=""
            >
        </div>

    {{else}}

        {{#if (eq phase "dark")}}

            <div class="exp-lwl__full-screen-image">
                <img
                    class="exp-lwl__startup-image"
                    src={{darkImageUrl}}
                    alt=""
                >
            </div>

        {{else}}

            {{#if (eq phase "intro")}}

                <div class="exp-lwl__intro-screen"></div>

            {{else}}

                {{#if (eq phase "stimulus")}}

                    <div class="exp-lwl__stimulus-container">
                        <div class="exp-lwl__stimulus-side">
                            <img
                                class="exp-lwl__image"
                                src={{leftImageUrl}}
                                alt=""
                            >
                        </div>

                        <div class="exp-lwl__stimulus-side">
                            <img
                                class="exp-lwl__image"
                                src={{rightImageUrl}}
                                alt=""
                            >
                        </div>
                    </div>

                {{else}}

                    {{#if (eq phase "intertrial")}}

                        <div class="exp-lwl__fixation">
                            <img
                                src={{fixationImageUrl}}
                                alt=""
                            >
                        </div>

                    {{else}}

                        {{#if (eq phase "attention")}}

                            <video
                                class="exp-lwl__attention-video"
                                src={{attentionVideoUrl}}
                                autoplay
                                playsinline
                                onended={{action "attentionEnded"}}
                            ></video>

                        {{/if}}

                    {{/if}}

                {{/if}}

            {{/if}}

        {{/if}}

    {{/if}}

{{/if}}